// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi Mi 10 umi — Linux 6.12 P0c OFFLINE-ONLY DTS SKELETON.
 *
 * NOT a bootable device-tree, NOT a validated board configuration.
 * No display, touch, PMIC supplies, UFS, USB, modem or charging are enabled.
 * Memory corrections below are real observed umi DT reg values.
 * DO NOT INSTALL, FLASH, or add this DTS to normal kernel Makefile targets.
 */

/dts-v1/;

#include "sm8250.dtsi"

/* Upstream SoC carveouts conflict with the current umi bootloader layout. */
/delete-node/ &xbl_aop_mem;
/delete-node/ &slpi_mem;
/delete-node/ &adsp_mem;
/delete-node/ &spss_mem;
/delete-node/ &cdsp_secure_heap;

/ {
    model = "Xiaomi Mi 10 (umi) — P0c research skeleton, not for boot";
    compatible = "xiaomi,umi", "qcom,sm8250";

    reserved-memory {
        /* P0b+ live FDT reg measurements, not node-name guesses. */
        xbl_aop_mem: xbl-aop@80600000 {
            reg = <0x0 0x80600000 0x0 0x260000>;
            no-map;
        };

        slpi_mem: slpi@88c00000 {
            reg = <0x0 0x88c00000 0x0 0x2f00000>;
            no-map;
        };

        adsp_mem: adsp@8bb00000 {
            reg = <0x0 0x8bb00000 0x0 0x2500000>;
            no-map;
        };

        spss_mem: spss@8e000000 {
            reg = <0x0 0x8e000000 0x0 0x100000>;
            no-map;
        };

        cdsp_secure_heap: cdsp-secure-heap@8e100000 {
            reg = <0x0 0x8e100000 0x0 0x4600000>;
            no-map;
        };
    };
};
